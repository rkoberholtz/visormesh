#include "resources.h"

VERSION ID 1 "0.1"
APPLICATIONICONNAME ID 1000 "VisorMesh"
ICONFAMILY "resources/icon/large1.bmp" "" "resources/icon/large4.bmp" "resources/icon/large8.bmp" TRANSPARENT 255 255 255
SMALLICONFAMILY "resources/icon/small1.bmp" "" "resources/icon/small4.bmp" "resources/icon/small8.bmp" TRANSPARENT 255 255 255

/*
 * Small UI font, registered as app font 0x80 at launch. tools/gen_font.py writes the
 * NFNT itself: this PilRC's FONT compiler emits a corrupt header (garbled text).
 */
DATA "NFNT" ID SmallFontRes "resources/smallfont.nfnt"
DATA "NFNT" ID LargeFontRes "resources/largefont.nfnt"
DATA "EMJI" ID EmojiArtRes "resources/emoji.bin"

/*
 * Menus: Go and Options on every screen; a Channel menu on Home and in a
 * channel conversation (main.c picks ConvoChanMenuBar or ConvoMenuBar for
 * ConvoForm); the standard Edit menu wherever there's a text field. The
 * Edit commands are the system's IDs: FrmHandleEvent applies them to the
 * field with the focus. App shortcuts keep clear of U X C P S K G.
 */
MENU ID MainMenuBar
BEGIN
  PULLDOWN "Go"
  BEGIN
    MENUITEM "Conversations" ID MainMenuHome "H"
    MENUITEM "Contacts" ID MainMenuContacts "T"
    MENUITEM "Node" ID MainMenuNode "N"
    MENUITEM "Map" ID MainMenuMap "W"
    MENUITEM "-" AUTOID
    MENUITEM "Heard Packets" ID MainMenuPackets
    MENUITEM "Radio Stats" ID MainMenuStats
    MENUITEM "Trace Path" ID MainMenuTrace
  END
  PULLDOWN "Options"
  BEGIN
    MENUITEM "Connect" ID MainMenuConnect
    MENUITEM "Flood Scopes..." ID MainMenuScopes "O"
    MENUITEM "Preferences..." ID MainMenuSounds "R"
    MENUITEM "-" AUTOID
    MENUITEM "Serial Ports..." ID MainMenuPorts "I"
    MENUITEM "Font Preview" ID MainMenuFontPreview "F"
    MENUITEM "Screenshot" ID MainMenuShot "Z"
    MENUITEM "Screenshot in 5 s" ID MainMenuShotLater "D"
    MENUITEM "-" AUTOID
    MENUITEM "About VisorMesh" ID MainMenuAbout
  END
END

MENU ID ContactsMenuBar
BEGIN
  PULLDOWN "Go"
  BEGIN
    MENUITEM "Conversations" ID MainMenuHome "H"
    MENUITEM "Contacts" ID MainMenuContacts "T"
    MENUITEM "Node" ID MainMenuNode "N"
    MENUITEM "Map" ID MainMenuMap "W"
    MENUITEM "-" AUTOID
    MENUITEM "Heard Packets" ID MainMenuPackets
    MENUITEM "Radio Stats" ID MainMenuStats
    MENUITEM "Trace Path" ID MainMenuTrace
  END
  PULLDOWN "Contacts"
  BEGIN
    MENUITEM "Beam My Contact" ID MainMenuBeamSelf "B"
    MENUITEM "Blocked Senders..." ID MainMenuBlocked
    MENUITEM "Remove Stale Contacts..." ID MainMenuStale
  END
  PULLDOWN "Options"
  BEGIN
    MENUITEM "Connect" ID MainMenuConnect
    MENUITEM "Flood Scopes..." ID MainMenuScopes "O"
    MENUITEM "Preferences..." ID MainMenuSounds "R"
    MENUITEM "-" AUTOID
    MENUITEM "Serial Ports..." ID MainMenuPorts "I"
    MENUITEM "Font Preview" ID MainMenuFontPreview "F"
    MENUITEM "Screenshot" ID MainMenuShot "Z"
    MENUITEM "Screenshot in 5 s" ID MainMenuShotLater "D"
    MENUITEM "-" AUTOID
    MENUITEM "About VisorMesh" ID MainMenuAbout
  END
END

MENU ID ConvoMenuBar
BEGIN
  PULLDOWN "Go"
  BEGIN
    MENUITEM "Conversations" ID MainMenuHome "H"
    MENUITEM "Contacts" ID MainMenuContacts "T"
    MENUITEM "Node" ID MainMenuNode "N"
    MENUITEM "Map" ID MainMenuMap "W"
    MENUITEM "-" AUTOID
    MENUITEM "Heard Packets" ID MainMenuPackets
    MENUITEM "Radio Stats" ID MainMenuStats
    MENUITEM "Trace Path" ID MainMenuTrace
  END
  PULLDOWN "Edit"
  BEGIN
    MENUITEM "Undo" ID 10000 "U"
    MENUITEM "Cut" ID 10001 "X"
    MENUITEM "Copy" ID 10002 "C"
    MENUITEM "Paste" ID 10003 "P"
    MENUITEM "Select All" ID 10004 "S"
    MENUITEM "-" ID 10005
    MENUITEM "Keyboard" ID 10006 "K"
    MENUITEM "Graffiti Help" ID 10007 "G"
  END
  PULLDOWN "Options"
  BEGIN
    MENUITEM "Message Actions..." ID MainMenuMessage "Y"
    MENUITEM "Insert Mention..." ID MainMenuMention "J"
    MENUITEM "-" AUTOID
    MENUITEM "Connect" ID MainMenuConnect
    MENUITEM "Flood Scopes..." ID MainMenuScopes "O"
    MENUITEM "Preferences..." ID MainMenuSounds "R"
    MENUITEM "-" AUTOID
    MENUITEM "Serial Ports..." ID MainMenuPorts "I"
    MENUITEM "Font Preview" ID MainMenuFontPreview "F"
    MENUITEM "Screenshot" ID MainMenuShot "Z"
    MENUITEM "Screenshot in 5 s" ID MainMenuShotLater "D"
    MENUITEM "-" AUTOID
    MENUITEM "About VisorMesh" ID MainMenuAbout
  END
END

