/* Home: the conversation list (channels, then direct) */
FORM ID HomeForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID HomeMenuBar
BEGIN
  TITLE "VisorMesh"
  GADGET ID HomeGadget AT (0 16 153 128)
  SCROLLBAR ID HomeScroll AT (153 16 7 128) VALUE 0 MIN 0 MAX 0 PAGESIZE 1
  BUTTON "Contacts" ID HomeContactsButton AT (1 147 AUTO AUTO)
  BUTTON "Node" ID HomeNodeButton AT (PREVRIGHT+5 PREVTOP AUTO AUTO)
  LIST "" ID HomeActionList AT (28 16 80 AUTO) NONUSABLE VISIBLEITEMS 4
END

/* One conversation: transcript, compose field, send */
FORM ID ConvoForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID ConvoMenuBar
BEGIN
  TITLE "                                "
  GADGET ID ConvoGadget AT (0 16 153 104)
  SCROLLBAR ID ConvoScroll AT (153 16 7 104) VALUE 0 MIN 0 MAX 0 PAGESIZE 1
  FIELD ID ConvoField AT (1 122 158 22) UNDERLINED MULTIPLELINES EDITABLE MAXCHARS 150 AUTOSHIFT
  BUTTON "Send" ID ConvoSendButton AT (1 147 AUTO AUTO)
  BUTTON "Back" ID ConvoBackButton AT (PREVRIGHT+5 PREVTOP AUTO AUTO)
  GRAFFITISTATEINDICATOR AT (150 148)
  LIST "" ID ConvoActionList AT (28 16 80 AUTO) NONUSABLE VISIBLEITEMS 6
  LIST "" ID ConvoMentionList AT (10 16 140 AUTO) NONUSABLE VISIBLEITEMS 8
END

/* Node: this radio's details, connection and settings */
FORM ID MainForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenuBar
BEGIN
  TITLE "Node"
  LABEL "Link:" AUTOID AT (5 18) FONT 1
  PUSHBUTTON "Serial" ID MainSerialPush AT (50 17 34 12) GROUP MainLinkGroup
  PUSHBUTTON "USB" ID MainUsbPush AT (PREVRIGHT+1 PREVTOP 34 12) GROUP MainLinkGroup
  PUSHBUTTON "Slot" ID MainSlotPush AT (PREVRIGHT+1 PREVTOP 34 12) GROUP MainLinkGroup

  LABEL "Node:" AUTOID AT (5 40) FONT 1
  LABEL "                      " ID MainNameLabel AT (50 40)
  LABEL "Freq:" AUTOID AT (5 54) FONT 1
  LABEL "                      " ID MainFreqLabel AT (50 54)
  LABEL "Mode:" AUTOID AT (5 66) FONT 1
  LABEL "                      " ID MainModeLabel AT (50 66)
  LABEL "Power:" AUTOID AT (5 78) FONT 1
  LABEL "                      " ID MainPowerLabel AT (50 78)
  LABEL "Firmware:" AUTOID AT (5 90) FONT 1
  LABEL "                      " ID MainFirmwareLabel AT (50 90)

  BUTTON "Settings" ID MainSettingsButton AT (5 127 AUTO AUTO)
  BUTTON "Advert" ID MainAdvertButton AT (PREVRIGHT+6 PREVTOP AUTO AUTO)
  BUTTON "Stats" ID MainStatsButton AT (PREVRIGHT+6 PREVTOP AUTO AUTO)
  BUTTON "Disconnect" ID MainConnectButton AT (5 145 AUTO AUTO)
  BUTTON "Done" ID MainDoneButton AT (PREVRIGHT+6 PREVTOP AUTO AUTO)
END

FORM ID ContactsForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID ContactsMenuBar
BEGIN
  TITLE "Contacts            "
  GADGET ID ContactsGadget AT (0 16 153 128)
  SCROLLBAR ID ContactsScroll AT (153 16 7 128) VALUE 0 MIN 0 MAX 0 PAGESIZE 1
  BUTTON "Refresh" ID ContactsRefreshButton AT (1 147 AUTO AUTO)
  BUTTON "Done" ID ContactsDoneButton AT (PREVRIGHT+5 PREVTOP AUTO AUTO)
  BUTTON "Add" ID ContactsAddButton AT (PREVRIGHT+5 PREVTOP AUTO AUTO)
  LIST "" ID ContactsBlockedList AT (10 16 140 AUTO) NONUSABLE VISIBLEITEMS 8
END

/* One contact: details and signal history */
FORM ID ContactForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenuBar
BEGIN
  TITLE "                                "
  GADGET ID ContactGadget AT (0 16 153 128)
  SCROLLBAR ID ContactScroll AT (153 16 7 128) VALUE 0 MIN 0 MAX 0 PAGESIZE 1
  BUTTON "Done" ID ContactDoneButton AT (1 147 AUTO AUTO)
  BUTTON "Message" ID ContactMessageButton AT (PREVRIGHT+4 PREVTOP AUTO AUTO)
  BUTTON "Login" ID ContactLoginButton AT (PREVRIGHT+4 PREVTOP AUTO AUTO)
  BUTTON "More" ID ContactMoreButton AT (PREVRIGHT+4 PREVTOP AUTO AUTO)
  LIST "" ID ContactMoreList AT (84 60 74 AUTO) NONUSABLE VISIBLEITEMS 8
END

FORM ID ContactAddForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID EditMenuBar
BEGIN
  TITLE "Add Contact"
  LABEL "Name:" AUTOID AT (5 20) FONT 1
  FIELD ID ContactAddNameField AT (40 20 115 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 31
  LABEL "Type:" AUTOID AT (5 38) FONT 1
  PUSHBUTTON "Chat" ID ContactAddChatPush AT (40 37 36 12) GROUP ContactAddTypeGroup
  PUSHBUTTON "Room" ID ContactAddRoomPush AT (PREVRIGHT+1 PREVTOP 36 12) GROUP ContactAddTypeGroup
  PUSHBUTTON "Repeater" ID ContactAddRepeaterPush AT (PREVRIGHT+1 PREVTOP 42 12) GROUP ContactAddTypeGroup
  LABEL "Public key (64 hex digits):" AUTOID AT (5 58) FONT 1
  FIELD ID ContactAddKeyField AT (5 72 150 36) UNDERLINED MULTIPLELINES EDITABLE MAXCHARS 80
  LABEL "For a node you haven't heard an advert" AUTOID AT (5 112)
  LABEL "from yet. Its path starts unknown (flood)." AUTOID AT (5 123)
  BUTTON "Add" ID ContactAddAddButton AT (5 145 AUTO AUTO)
  BUTTON "Cancel" ID ContactAddCancelButton AT (PREVRIGHT+6 PREVTOP AUTO AUTO)
  GRAFFITISTATEINDICATOR AT (145 147)
END

/* Remote admin console for a repeater or room */
FORM ID RemoteForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID ConvoMenuBar
BEGIN
  TITLE "                                "
  GADGET ID RemoteGadget AT (0 16 153 114)
  SCROLLBAR ID RemoteScroll AT (153 16 7 114) VALUE 0 MIN 0 MAX 0 PAGESIZE 1
  FIELD ID RemoteField AT (1 132 148 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 140
  GRAFFITISTATEINDICATOR AT (151 133)
  BUTTON "Send" ID RemoteSendButton AT (1 147 25 12)
  BUTTON "Status" ID RemoteStatusButton AT (PREVRIGHT+3 PREVTOP 31 12)
  BUTTON "Telem" ID RemoteTelemButton AT (PREVRIGHT+3 PREVTOP 29 12)
  BUTTON "Cmds" ID RemoteCmdsButton AT (PREVRIGHT+3 PREVTOP 28 12)
  BUTTON "Done" ID RemoteDoneButton AT (PREVRIGHT+3 PREVTOP 27 12)
  LIST "Read settings" "ver" "clock" "clock sync" "neighbors" "advert" "advert.zerohop"
       "stats-core" "stats-radio" "stats-packets" "get acl" "clear stats"
       "set name..." "set tx..." "set radio..." "set repeat..." "set advert.interval..."
       "set flood.advert.interval..." "set flood.max..." "set guest.password..." "password..."
       "reboot..."
       ID RemoteCmdList AT (30 16 128 AUTO) NONUSABLE VISIBLEITEMS 12
END

ALERT ID PasswordAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Log In"
  MESSAGE "Password for ^1:"
  BUTTONS "Log In" "Cancel"
END

ALERT ID RemoveContactAlert
WARNING
DEFAULTBUTTON 1
BEGIN
  TITLE "Remove Contact"
  MESSAGE "Remove ^1 from the radio's contacts? Its messages stay on the Visor."
  BUTTONS "Remove" "Cancel"
END

ALERT ID ContactInfoAlert
INFORMATION
BEGIN
  TITLE "Contact"
  MESSAGE "^1\n^2"
  BUTTONS "OK" "Message"
END

ALERT ID AdvertAlert
CONFIRMATION
DEFAULTBUTTON 2
BEGIN
  TITLE "Send Advert"
  MESSAGE "Let other nodes add you. Zero-hop reaches only nodes that hear you directly; flood goes through repeaters."
  BUTTONS "Zero-hop" "Flood" "Cancel"
END

ALERT ID PathAlert
INFORMATION
BEGIN
  TITLE "Message Path"
  MESSAGE "^1"
  BUTTONS "OK"
END

ALERT ID ReactionsAlert
INFORMATION
BEGIN
  TITLE "Reactions"
  MESSAGE "^1"
  BUTTONS "OK"
END

ALERT ID RetryAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Not Delivered"
  MESSAGE "This message wasn't confirmed. Send it again?"
  BUTTONS "Retry" "Cancel"
END

FORM ID SettingsForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID EditMenuBar
SAVEBEHIND
BEGIN
  TITLE "Node Settings"
  LABEL "Name:" AUTOID AT (5 18) FONT 1
  FIELD ID SettingsNameField AT (45 18 110 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 31

  LABEL "Preset:" AUTOID AT (5 34) FONT 1
  POPUPTRIGGER "Custom" ID SettingsPresetTrigger AT (45 33 AUTO AUTO) LEFTANCHOR
  LIST "" ID SettingsPresetList AT (40 33 118 AUTO) NONUSABLE VISIBLEITEMS 10
  POPUPLIST ID SettingsPresetTrigger SettingsPresetList

  LABEL "Freq:" AUTOID AT (5 50) FONT 1
  FIELD ID SettingsFreqField AT (45 50 45 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 9
  LABEL "MHz" AUTOID AT (93 50)

  LABEL "BW:" AUTOID AT (5 64) FONT 1
  FIELD ID SettingsBwField AT (45 64 30 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 6
  LABEL "kHz" AUTOID AT (78 64)

  LABEL "SF:" AUTOID AT (5 78) FONT 1
  FIELD ID SettingsSfField AT (45 78 16 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 2 NUMERIC
  LABEL "CR:" AUTOID AT (75 78) FONT 1
  FIELD ID SettingsCrField AT (95 78 12 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 1 NUMERIC

  LABEL "Power:" AUTOID AT (5 92) FONT 1
  FIELD ID SettingsPowerField AT (45 92 20 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 3
  LABEL "dBm" AUTOID AT (68 92)
  LABEL "UTC:" AUTOID AT (95 92) FONT 1
  FIELD ID SettingsUtcField AT (120 92 24 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 5
  LABEL "h" AUTOID AT (147 92)

  LABEL "Path hash:" AUTOID AT (5 107) FONT 1
  PUSHBUTTON "1B" ID SettingsHash1Push AT (60 106 20 12) GROUP SettingsHashGroup
  PUSHBUTTON "2B" ID SettingsHash2Push AT (PREVRIGHT+1 PREVTOP 20 12) GROUP SettingsHashGroup
  PUSHBUTTON "3B" ID SettingsHash3Push AT (PREVRIGHT+1 PREVTOP 20 12) GROUP SettingsHashGroup

  LABEL "                              " ID SettingsStatusLabel AT (5 124)

  BUTTON "Save" ID SettingsSaveButton AT (5 140 AUTO AUTO)
  BUTTON "Cancel" ID SettingsCancelButton AT (PREVRIGHT+6 PREVTOP AUTO AUTO)
  GRAFFITISTATEINDICATOR AT (145 145)
END

ALERT ID SettingsErrorAlert
ERROR
BEGIN
  TITLE "Settings"
  MESSAGE "^1"
  BUTTONS "OK"
END

FORM ID PortsForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
  TITLE "Serial Ports"
  BUTTON "Done" ID PortsDoneButton AT (CENTER 145 AUTO AUTO)
END

/* Sounds: checkbox IDs are SoundsFirstCheck + VM_SND_* (sounds.h) */
FORM ID SoundsForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
  TITLE "Preferences"
  LABEL "Text size:" AUTOID AT (5 18) FONT 1
  PUSHBUTTON "Small" ID SoundsSmallPush AT (60 17 36 12) GROUP SoundsTextGroup
  PUSHBUTTON "Large" ID SoundsLargePush AT (PREVRIGHT+1 PREVTOP 36 12) GROUP SoundsTextGroup
  CHECKBOX "Direct messages" ID 2201 AT (5 30 AUTO 11)
  CHECKBOX "Mentions of me" ID 2202 AT (5 PREVBOTTOM AUTO 11)
  CHECKBOX "Room posts" ID 2203 AT (5 PREVBOTTOM AUTO 11)
  CHECKBOX "Private channels" ID 2204 AT (5 PREVBOTTOM AUTO 11)
  CHECKBOX "Hashtag channels" ID 2205 AT (5 PREVBOTTOM AUTO 11)
  CHECKBOX "Public channel" ID 2206 AT (5 PREVBOTTOM AUTO 11)
  CHECKBOX "New contacts" ID 2207 AT (5 PREVBOTTOM AUTO 11)
  LABEL "Turning a sound on plays it." AUTOID AT (5 PREVBOTTOM+1)
  LABEL "Volume: Prefs, General, Alarm          " ID SoundsStatusLabel AT (5 PREVBOTTOM)
  LABEL "Check when closed:" AUTOID AT (5 132) FONT 1
  POPUPTRIGGER "Off" ID SoundsCheckTrigger AT (95 131 AUTO AUTO) LEFTANCHOR
  LIST "Off" "Every 5 min" "Every 15 min" "Every 30 min" "Every hour" ID SoundsCheckList AT (90 90 66 AUTO) NONUSABLE VISIBLEITEMS 5
  POPUPLIST ID SoundsCheckTrigger SoundsCheckList
  BUTTON "Done" ID SoundsDoneButton AT (CENTER 147 AUTO AUTO)
END

/* Flood scopes: the list, and the radio's default */
FORM ID ScopesForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID EditMenuBar
BEGIN
  TITLE "Flood Scopes"
  LABEL "Radio default:" AUTOID AT (5 17) FONT 1
  LABEL "                              " ID ScopesDefaultLabel AT (75 17)
  LIST "" ID ScopesList AT (5 31 150 AUTO) VISIBLEITEMS 6
  FIELD ID ScopesField AT (5 100 68 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 31
  BUTTON "Add" ID ScopesAddButton AT (78 99 30 12)
  BUTTON "Discover" ID ScopesDiscoverButton AT (PREVRIGHT+4 PREVTOP 43 12)
  BUTTON "Delete" ID ScopesDeleteButton AT (5 116 36 12)
  BUTTON "Set Default" ID ScopesSetDefaultButton AT (PREVRIGHT+4 PREVTOP 52 12)
  BUTTON "No Default" ID ScopesClearDefaultButton AT (PREVRIGHT+4 PREVTOP 52 12)
  BUTTON "Done" ID ScopesDoneButton AT (CENTER 145 AUTO AUTO)
  GRAFFITISTATEINDICATOR AT (150 148)
END

ALERT ID ScopeAlert
INFORMATION
BEGIN
  TITLE "Flood Scopes"
  MESSAGE "^1"
  BUTTONS "OK"
END

/* Channel Scope: which scope this channel's messages flood in */
FORM ID ChanScopeForm AT (2 28 156 130)
MODAL
DEFAULTBTNID ChanScopeCancelButton
BEGIN
  TITLE "Channel Scope"
  LABEL "Flood this channel in:" AUTOID AT (5 15)
  LIST "" ID ChanScopeList AT (5 28 146 AUTO) VISIBLEITEMS 7
  BUTTON "OK" ID ChanScopeOKButton AT (5 113 36 12)
  BUTTON "Cancel" ID ChanScopeCancelButton AT (PREVRIGHT+5 PREVTOP 36 12)
END

/* Map: the basemap with positioned nodes; drag to pan, tap a node, tap again to open */
FORM ID MapForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenuBar
BEGIN
  TITLE "Map"
  GADGET ID MapGadget AT (0 15 160 130)
  BUTTON "Done" ID MapDoneButton AT (1 147 28 12)
  BUTTON "-" ID MapOutButton AT (PREVRIGHT+4 PREVTOP 14 12)
  BUTTON "+" ID MapInButton AT (PREVRIGHT+2 PREVTOP 14 12)
END

