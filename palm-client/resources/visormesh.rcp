FORM ID FontPreviewForm AT (0 0 160 160)
NOFRAME
USABLE
BEGIN
  TITLE "Font Preview"
  BUTTON "Done" ID FontPreviewDoneButton AT (CENTER 147 AUTO AUTO)
END

/* Add a #hashtag channel, or join a private one with its key */
FORM ID ChannelForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID EditMenuBar
BEGIN
  TITLE "Add Channel"
  LABEL "Name:" AUTOID AT (5 20) FONT 1
  FIELD ID ChannelNameField AT (40 20 115 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 30
  LABEL "Type:" AUTOID AT (5 38) FONT 1
  PUSHBUTTON "#hashtag" ID ChannelHashtagPush AT (40 37 50 12) GROUP ChannelTypeGroup
  PUSHBUTTON "Private" ID ChannelPrivatePush AT (PREVRIGHT+1 PREVTOP 50 12) GROUP ChannelTypeGroup
  LABEL "Key (32 hex digits):" ID ChannelKeyLabel AT (5 58) FONT 1
  FIELD ID ChannelKeyField AT (5 72 150 24) UNDERLINED MULTIPLELINES EDITABLE MAXCHARS 39
  LABEL "A #hashtag channel's key comes from its name:" AUTOID AT (5 104)
  LABEL "anyone who knows the name can read it." AUTOID AT (5 115)
  BUTTON "Add" ID ChannelAddButton AT (5 145 AUTO AUTO)
  BUTTON "Cancel" ID ChannelCancelButton AT (PREVRIGHT+6 PREVTOP AUTO AUTO)
  GRAFFITISTATEINDICATOR AT (145 147)
END

ALERT ID LeaveChannelAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Leave Channel"
  MESSAGE "Remove ^1 from the radio? Its messages stay on the Visor."
  BUTTONS "Leave" "Cancel"
END

/* Radio Stats: the companion radio's own report (stats_form.c) */
FORM ID StatsForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenuBar
BEGIN
  TITLE "Radio Stats"
  BUTTON "Done" ID StatsDoneButton AT (1 147 AUTO AUTO)
END

/* Heard Packets: the radio's RX log (packets_form.c) */
FORM ID PacketsForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID MainMenuBar
BEGIN
  TITLE "Heard Packets"
  GADGET ID PacketsGadget AT (0 16 153 128)
  SCROLLBAR ID PacketsScroll AT (153 16 7 128) VALUE 0 MIN 0 MAX 0 PAGESIZE 1
  BUTTON "Done" ID PacketsDoneButton AT (1 147 AUTO AUTO)
  PUSHBUTTON "All" ID PacketsAllPush AT (60 147 26 12) GROUP PacketsFilterGroup
  PUSHBUTTON "Chat" ID PacketsMsgPush AT (PREVRIGHT+1 PREVTOP 30 12) GROUP PacketsFilterGroup
  PUSHBUTTON "Adverts" ID PacketsAdvertPush AT (PREVRIGHT+1 PREVTOP 40 12) GROUP PacketsFilterGroup
END

ALERT ID PacketAlert
INFORMATION
BEGIN
  TITLE "Packet"
  MESSAGE "^1"
  BUTTONS "OK"
END

/* Trace Path: hops out and back, SNR at each (trace_form.c); for a contact, also its route */
FORM ID TraceForm AT (0 0 160 160)
NOFRAME
USABLE
MENUID EditMenuBar
BEGIN
  TITLE "Trace Path"
  LABEL "                                        " ID TraceForLabel AT (3 16)
  LABEL "Hops:" AUTOID AT (3 29) FONT 1
  FIELD ID TraceField AT (32 29 97 12) UNDERLINED SINGLELINE EDITABLE MAXCHARS 60
  BUTTON "Add" ID TraceAddButton AT (132 28 26 12)
  CHECKBOX "Round trip (back the same way)" ID TraceRoundCheck AT (1 42 AUTO 12)
  GADGET ID TraceGadget AT (0 56 153 88)
  SCROLLBAR ID TraceScroll AT (153 56 7 88) VALUE 0 MIN 0 MAX 0 PAGESIZE 1
  BUTTON "Trace" ID TraceGoButton AT (1 147 AUTO AUTO)
  BUTTON "Set Route" ID TraceRouteButton AT (PREVRIGHT+5 PREVTOP AUTO AUTO)
  BUTTON "Done" ID TraceDoneButton AT (PREVRIGHT+5 PREVTOP AUTO AUTO)
  GRAFFITISTATEINDICATOR AT (150 148)
  LIST "" ID TraceHopList AT (40 16 118 AUTO) NONUSABLE VISIBLEITEMS 10
END

ALERT ID TraceRouteAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Set Route"
  MESSAGE "Send to ^1 ^2?"
  BUTTONS "Set Route" "Cancel"
END

ALERT ID PingAlert
INFORMATION
BEGIN
  TITLE "Ping"
  MESSAGE "^1"
  BUTTONS "OK"
END

ALERT ID StaleAlert
CONFIRMATION
DEFAULTBUTTON 3
BEGIN
  TITLE "Remove Stale Contacts"
  MESSAGE "Remove contacts the radio hasn't heard an advert from in:"
  BUTTONS "2 weeks" "1 month" "3 months" "Cancel"
END

ALERT ID StaleConfirmAlert
WARNING
DEFAULTBUTTON 1
BEGIN
  TITLE "Remove Stale Contacts"
  MESSAGE "Remove ^1 from the radio? Kept: contacts you have messages with, ones never heard (added by key) and ones you're logged into. Their messages stay on the Visor."
  BUTTONS "Remove" "Cancel"
END

ALERT ID BlockAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Block"
  MESSAGE "Hide messages and reactions from ^1? Unblock under Contacts > Blocked Senders."
  BUTTONS "Block" "Cancel"
END

ALERT ID UnblockAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Unblock"
  MESSAGE "Show messages from ^1 again?"
  BUTTONS "Unblock" "Cancel"
END

ALERT ID InboxContactAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Contact Received"
  MESSAGE "Add ^1 (^2) to the radio's contacts?"
  BUTTONS "Add" "Later" "Discard"
END

ALERT ID InboxChannelAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Channel Received"
  MESSAGE "Join ^1?"
  BUTTONS "Join" "Later" "Discard"
END

ALERT ID HashtagAlert
CONFIRMATION
DEFAULTBUTTON 1
BEGIN
  TITLE "Join Channel"
  MESSAGE "Join ^1? Anyone who knows the name can read it."
  BUTTONS "Join" "Cancel"
END

ALERT ID NoteAlert
INFORMATION
BEGIN
  TITLE "VisorMesh"
  MESSAGE "^1"
  BUTTONS "OK"
END
